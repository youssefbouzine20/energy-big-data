# Backend-specific overrides. The backend ALSO reads the root .env (../../.env)
# so anything already set there (MONGO_*, etc.) works without duplication.
# This file only documents the extras the API needs.

# API server
API_PORT=4000

# CORS — comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# JWT — change before deploy, must be at least 32 chars
JWT_SECRET=dev-change-me-32-chars-minimum-secret-key
JWT_EXPIRES_IN=8h

# Mock auth users (demo only — replace with real DB users in production)
# Format: username:password:role,username:password:role
AUTH_USERS=admin:admin123:admin,operator:operator123:operator
