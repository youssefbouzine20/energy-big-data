# =============================================================================
# KAFKA
# KAFKA_HOST: 'localhost' for local dev, 'kafka' inside Docker network.
# KAFKA_BOOTSTRAP_SERVERS overrides KAFKA_HOST:KAFKA_PORT when set.
#   Local mode:       localhost:9092
#   Distributed mode: kafka1:29092,kafka2:29092,kafka3:29092
# =============================================================================
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REPLICATION_FACTOR=1
KAFKA_TOPIC_METERS=smart-meters
KAFKA_TOPIC_WEATHER=weather
KAFKA_TOPIC_INCIDENTS=incident-reports
KAFKA_CONSUMER_GROUP=energy-spark-consumer

# Generate with: docker run --rm confluentinc/cp-kafka:7.5.0 kafka-storage random-uuid
KAFKA_CLUSTER_ID=<paste uuid here>

# =============================================================================
# SCHEMA REGISTRY & KAFKA UI
# Schema Registry: central catalog of JSON schemas (Confluent). Producers still
#                  validate client-side via jsonschema; the registry is for
#                  visibility in Kafka UI and future Spark/consumer integration.
# Kafka UI:        Provectus web UI for topics, messages, consumer groups, schemas.
# =============================================================================
SCHEMA_REGISTRY_URL=http://localhost:8081
SCHEMA_REGISTRY_PORT=8081
KAFKA_UI_PORT=8090

# =============================================================================
# PRODUCERS
# PRODUCER_INTERVAL_SECONDS: how often smart-meter & weather producers send.
# NUM_METERS: number of virtual smart meters (recommended: 10).
# INCIDENT_INTERVAL_SECONDS: how often an incident report is generated.
# =============================================================================
PRODUCER_INTERVAL_SECONDS=30
NUM_METERS=20
INCIDENT_INTERVAL_SECONDS=60

# =============================================================================
# SPARK
# SPARK_MASTER: 'local[*]' for local, 'spark://spark-master:7077' for cluster.
# =============================================================================
SPARK_MASTER=local[*]
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=1g
SPARK_WORKER_CORES=1

# =============================================================================
# MONGODB
# Coordinate MONGO_USERNAME and MONGO_PASSWORD with P3 before deploying.
# =============================================================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=energy_db
MONGO_USERNAME=
MONGO_PASSWORD=

# =============================================================================
# STREAMLIT
# =============================================================================
STREAMLIT_PORT=8501