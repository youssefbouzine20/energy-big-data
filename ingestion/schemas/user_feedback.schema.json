{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserFeedback",
  "description": "User feedback from support platforms — input for P2 NLP analysis (Section B.4).",
  "type": "object",
  "required": [
    "schema_version",
    "feedback_id",
    "timestamp",
    "user_id",
    "zone",
    "channel",
    "sentiment",
    "category",
    "text",
    "resolved"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "feedback_id": {
      "type": "string",
      "pattern": "^FB-[0-9]{8}-[0-9]{3}$",
      "description": "Unique feedback ID e.g. FB-20260515-001"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "user_id": {
      "type": "string",
      "pattern": "^U-[0-9]{5}$",
      "description": "Pseudonymous user identifier (GDPR-compliant — no PII)"
    },
    "zone": {
      "type": "string",
      "enum": ["A", "B", "C", "D"],
      "description": "Geographic zone of the user — enables zone-level correlation with meters_raw"
    },
    "channel": {
      "type": "string",
      "enum": ["WEB", "MOBILE", "CALL_CENTER", "EMAIL"],
      "description": "Source platform — feature for channel-bias analysis"
    },
    "sentiment": {
      "type": "string",
      "enum": ["POSITIVE", "NEGATIVE", "NEUTRAL"],
      "description": "Pre-tagged sentiment — ground truth for P2 NLP validation"
    },
    "category": {
      "type": "string",
      "enum": ["OUTAGE", "BILLING", "QUALITY", "GENERAL"],
      "description": "Complaint type — correlates with incident_reports.type"
    },
    "text": {
      "type": "string",
      "minLength": 30,
      "maxLength": 1000,
      "description": "Free-text body — primary input for NLP tokenization + sentiment + topic modeling"
    },
    "resolved": {
      "type": "boolean",
      "description": "False when produced; P3/P2 can update after follow-up"
    }
  },
  "additionalProperties": false
}
