{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IncidentReport",
  "type": "object",
  "required": [
    "schema_version",
    "incident_id",
    "timestamp",
    "zone",
    "severity",
    "type",
    "description",
    "affected_meters",
    "estimated_duration_min",
    "resolved"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "incident_id": {
      "type": "string",
      "pattern": "^INC-[0-9]{8}-[0-9]{3}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "zone": {
      "type": "string",
      "enum": ["A", "B", "C", "D"]
    },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "type": {
      "type": "string",
      "enum": [
        "VOLTAGE_DROP", "VOLTAGE_SURGE", "POWER_OUTAGE",
        "OVERLOAD", "EQUIPMENT_FAILURE", "GRID_FAULT"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 30,
      "maxLength": 500,
      "description": "Rich NLP text — must include location, cause, impact details"
    },
    "affected_meters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SM-[0-9]{3}$"
      },
      "minItems": 1,
      "maxItems": 10
    },
    "estimated_duration_min": {
      "type": "integer",
      "minimum": 1,
      "maximum": 480,
      "description": "Estimated incident duration in minutes — useful for Spark windowing"
    },
    "resolved": {
      "type": "boolean",
      "description": "False when produced, Spark or P3 can update to true"
    }
  },
  "additionalProperties": false
}